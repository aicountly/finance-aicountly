# Finance API. Console (console.aicountly.org) is the sole identity provider —
# Finance has no user table and exchanges Console credentials for a short-lived
# Finance portal JWT (console-react-app AUTH_INTEGRATION.md). PostgreSQL holds
# the weekly seller payout ledger only (see docs/DEPLOYMENT.md).

APP_ENV=development
BASE_URL=http://localhost:8080
# Production example: BASE_URL=https://finance.aicountly.org/api

# Where the SSO callback redirects the browser back to after issuing a
# Finance JWT (the web/ SPA root).
FRONTEND_URL=http://localhost:5173
# Production example: FRONTEND_URL=https://finance.aicountly.org

# Console is the identity provider for all Top Controller apps.
CONSOLE_API_URL=https://console.aicountly.org/api
CONTROLLER_APP_CODE=finance

# Finance roles (finance_admin, payout_approver, accountant, finance_viewer)
# are assigned in Console. Every
# authenticated request re-checks them with
#   GET {CONSOLE_API_URL}/portal/controller-apps/user-access?app_code=finance&…
# using this service token (Console capability `staff.roles`), cached 60 s.
# PRODUCTION MUST SET IT — without it a role revoked in Console keeps working
# until the Finance JWT expires (a warning is logged on every request).
CONSOLE_API_TOKEN=
# Optional: where the 60 s role cache lives when APCu is unavailable
# (default: a finance-authz-* folder in the system temp directory).
# FINANCE_AUTHZ_CACHE_DIR=

# Signs the local Finance portal JWT issued after a successful Console SSO
# exchange. Must NOT match Console's own JWT_SECRET — these are separate
# tokens for separate audiences.
JWT_SECRET=change_me_to_a_long_random_value
TOKEN_TTL_HOURS=8

CORS_ORIGIN=http://localhost:5173
# Comma-separated list; overrides CORS_ORIGIN when set.
# CORS_ORIGINS=http://localhost:5173,https://finance.aicountly.org

# ---------------------------------------------------------------------------
# Weekly seller payouts
# ---------------------------------------------------------------------------

# PostgreSQL for the payout ledger. Apply the schema with `php bin/migrate.php`
# (the deploy workflow runs it after every upload). Unset → payout routes
# answer 503 "not configured" and /api/health reports database: false.
FINANCE_DB_HOST=127.0.0.1
FINANCE_DB_PORT=5432
FINANCE_DB_NAME=finance
FINANCE_DB_USER=finance
FINANCE_DB_PASSWORD=

# Encrypts PAN, GSTIN, bank account numbers and generated bank files at rest
# (libsodium secretbox). 32 random bytes as 64 hex characters (or base64):
#   php -r 'echo bin2hex(random_bytes(32)), PHP_EOL;'
# Unset → Finance refuses to accept batches (503). BACK IT UP with the database
# credentials: losing it makes every stored PAN and account number unreadable.
# Never change it on a database that already holds payees.
FINANCE_DATA_KEY=

# Engage → Finance: Engage sends weekly payout batches to
#   POST /api/v1/inbound/engage/payout-batches   with header X-Engage-Key
# Same value as FINANCE_OUTBOUND_KEY in Engage's .env. At least 32
# characters; unset → 503, wrong → 401.
FINANCE_INBOUND_ENGAGE_KEY=

# Finance → Engage: per-item status callbacks (approved | on_hold | paid |
# failed | reversed), queued in the outbox and sent by bin/outbox-deliver.php
# (cron, every 5 minutes) to
#   POST {ENGAGE_API_BASE_URL}/v1/inbound/finance/payout-status   with header X-Finance-Key
# ENGAGE_FINANCE_KEY must equal ENGAGE_INBOUND_FINANCE_KEY in Engage's .env
# (≥ 32 characters). Unset → updates wait in the outbox; nothing is sent.
# Keep the /api: without it the POST reaches engage's web app (200 index.html),
# which is not Engage's receipt — the update stays undelivered and is retried.
ENGAGE_API_BASE_URL=https://engage.aicountly.org/api
ENGAGE_FINANCE_KEY=
